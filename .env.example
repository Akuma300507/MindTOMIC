# Server Port
PORT=3000

# SOLUTION 1: PERSISTENT CLOUD DATA STORAGE & CDN
# -----------------------------------------------------------------------------
# 1. MongoDB Atlas URI (Free Cloud Database)
# Keeps participants, topics, images, timer states, and settings permanently stored
# in the cloud even when the server restarts or sleeps.
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""

# 2. Cloudinary URL (Free Cloud Media CDN)
# Stores uploaded image files on Cloudinary's fast CDN instead of the server's local disk.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""
# Or individual Cloudinary keys:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# AI Studio / Gemini API Key (optional)
GEMINI_API_KEY=""
APP_URL=""
